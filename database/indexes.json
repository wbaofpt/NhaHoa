{
  "favorites": [{ "key": { "user_id": 1, "product_id": 1 }, "unique": true }],
  "users": [
    { "key": { "id": 1 }, "unique": true },
    { "key": { "email": 1 }, "unique": true }
  ],
  "products": [
    { "key": { "id": 1 }, "unique": true },
    { "key": { "slug": 1 }, "unique": true },
    { "key": { "active": 1, "category": 1 } }
  ],
  "orders": [
    { "key": { "id": 1 }, "unique": true },
    { "key": { "user_id": 1, "created_at": -1 } },
    { "key": { "email": 1, "id": 1 } }
  ],
  "sessions": [
    { "key": { "token_hash": 1 }, "unique": true },
    { "key": { "expires_at": 1 }, "expireAfterSeconds": 0 },
    { "key": { "user_id": 1 } }
  ],
  "inquiries": [
    { "key": { "id": 1 }, "unique": true },
    { "key": { "created_at": -1 } }
  ],
  "subscribers": [{ "key": { "email": 1 }, "unique": true }]
}
