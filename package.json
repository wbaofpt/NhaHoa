{
  "name": "nha-hoa",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:setup": "npm run db:setup -w backend",
    "test": "npm run test -w backend",
    "test:e2e": "node tests/run-e2e.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
